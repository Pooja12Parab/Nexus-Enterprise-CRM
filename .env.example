# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexus_crm?schema=public"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Webhook (for Clerk user sync)
CLERK_WEBHOOK_SECRET="whsec_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
ADMIN_USER="admin@example.com"
ADMIN_PASSWORD="your-password"

# --- AI / LLM integration (Vercel AI SDK + Google Gemini) ---

# Get your key at https://aistudio.google.com/app/apikey (free, no card needed).
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy_replace_me"

# Test-only auth bypass (NEVER set this in production).
# When E2E_BYPASS_AUTH=1, the app skips Clerk auth entirely and uses a synthetic
# SUPER_ADMIN session. This is enabled by default for `npm run dev` in this repo
# so demos and screenshot capture don't require reading a 6-digit email OTP.
# Set to "0" or remove to use real Clerk auth.
E2E_BYPASS_AUTH="1"
NEXT_PUBLIC_E2E_BYPASS_AUTH="1"

# --- MCP server (Model Context Protocol) ---

# API key for external MCP clients (Claude Desktop, ChatGPT, Cursor, etc.).
# Generate with: openssl rand -hex 32
# External clients paste this into their MCP server config as a Bearer token.
MCP_API_KEY="replace_me_with_a_random_32_byte_hex"
